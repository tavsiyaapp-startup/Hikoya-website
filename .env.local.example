# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth — Google Cloud Console → APIs & Services → Credentials
# Configured in Supabase Auth → Providers → Google (redirect URL supplied there),
# these two are only needed if you also call Google's API directly.
# Authorized redirect URI to paste into the Google OAuth client:
# https://krmyymorexsfwpvkfqzq.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of this app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram support bot — BotFather → your bot; webhook is
# /api/telegram/support (see that route for setup). Group chat id is where
# tickets get forwarded (numeric, usually negative for groups).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPPORT_GROUP_CHAT_ID=
