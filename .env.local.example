# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth — Google Cloud Console → APIs & Services → Credentials
# Configured in Supabase Auth → Providers → Google (redirect URL supplied there),
# these two are only needed if you also call Google's API directly.
# Authorized redirect URI to paste into the Google OAuth client:
# https://tslhdlkrtgbzmgwwinxd.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login Widget — create a bot with @BotFather, then run
# /setdomain in BotFather to whitelist this app's domain
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Base URL of this app (used for auth redirects and the Telegram widget)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
