# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# supabase CLI local cache
/supabase/.temp/

# admin credentials (local reference only, never commit)
admin-credentials.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# Local data exports — contain user emails and password hashes, never commit
full_backup.sql
storage files.csv

# User-uploaded files (avatars/covers/chapter images/banners) — written
# directly to disk on the server by src/server/storage/local.ts, never
# checked into the repo. Deploys never touch this folder either way (see
# that file's comment), but keeping it out of git avoids ever accidentally
# committing a local test upload.
/public/uploads/

